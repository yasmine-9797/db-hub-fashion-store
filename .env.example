# DB Hub Cloth Store — environment variables
# Copy to `.env` for local development (never commit real values). In production set these as
# server-side secrets in your hosting provider. Only variables prefixed VITE_ reach the browser.

# ---- Public (safe in the browser) ---------------------------------------------------------
# Your live origin, no trailing slash. Used for canonical URLs, Open Graph and the sitemap.
VITE_SITE_URL=https://www.example.com

# ---- Razorpay (server only) ---------------------------------------------------------------
# Dashboard → Account & Settings → API Keys. Use rzp_test_… keys until you've tested end to end.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret you set for https://<domain>/api/razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- Order storage: Supabase (server only) ------------------------------------------------
# Project Settings → API. The service-role key bypasses RLS — keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Secrets for links and admin sessions (server only) -----------------------------------
# Generate each with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# SESSION_SECRET seals the admin cookie (min 32 chars). ORDER_TOKEN_SECRET signs private
# order links (falls back to SESSION_SECRET). Changing them invalidates existing links/sessions.
SESSION_SECRET=
ORDER_TOKEN_SECRET=
ADMIN_PASSWORD=

# ---- Previews only ------------------------------------------------------------------------
# Allows the in-memory order store outside local dev (data is lost on restart — never in production).
# ALLOW_MEMORY_STORE=true
